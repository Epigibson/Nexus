# ─── Nexus API — Environment Variables ───
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Database — PostgreSQL (Supabase)
# Password URL-encoded: / → %2F, # → %23
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Auth — Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_KEY
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=15

# AWS Cognito
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_CLIENT_ID=your-client-id

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["https://your-domain.com"]

# App
DEBUG=false
FRONTEND_URL=https://your-domain.com
ENVIRONMENT=production

# Admin email (used for bootstrap admin account)
ADMIN_EMAIL=admin@your-domain.com

# Stripe
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PREMIUM_PRICE_ID=auto
# Updated DATABASE_URL to use Supabase pooler
