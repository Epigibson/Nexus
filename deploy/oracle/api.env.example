# Copiar a /etc/nexus/api.env (chmod 640, root:nexus). NO commitear valores reales.
# Formato systemd: un KEY=valor por línea, comentarios solo en su propia línea.
# Valores con comillas dobles internas (JSON) van entre comillas simples.

ENVIRONMENT=production
DEBUG=false

# Supabase en East US (North Virginia), junto a la VM de Ashburn (~3 ms por consulta; desde Oregon eran ~80 ms).
# Pooler en modo sesión (puerto 5432): la VM no tiene IPv6 y la API mantiene un pool de conexiones.
# Si la contraseña tiene caracteres especiales (@ # / : ...), van codificados en la URL (%40 %23 %2F %3A).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# Mismos valores que en producción actual (SSM /nexus/prod/* o secrets de GitHub).
# Si cambias ENCRYPTION_KEY no podrás descifrar los secretos guardados. Cambiar SECRET_KEY solo cierra las sesiones abiertas.
SECRET_KEY=
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Correo para códigos de verificación y recuperación de contraseña (reemplaza los correos de Cognito).
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASSWORD=<API key de Resend>
# OCI Email Delivery: SMTP_HOST=smtp.email.<region>.oci.oraclecloud.com, SMTP_PORT=587, credenciales SMTP del usuario OCI
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Nexus <no-reply@nexusproject.pro>"

CORS_ORIGINS='["https://nexusproject.pro","https://www.nexusproject.pro"]'
FRONTEND_URL=https://nexusproject.pro
ADMIN_EMAIL=

# Stripe — recuerda crear el webhook nuevo apuntando a https://api.nexusproject.pro/api/v1/billing/webhook
# (su secreto whsec_ es distinto al del webhook de API Gateway)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Procesos uvicorn (ver nota en nexus-api.service)
# API_WORKERS=1
